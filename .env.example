# =============================================================================
# digiKOT — SQLite + embedded stack (no Supabase / Docker required)
# =============================================================================
# Copy to .env for production laptop, or .env.local for local dev overrides.
# Never commit .env, .env.local, data/, or logs.

# --- Production ---
NODE_ENV=production
PORT=3000
LISTEN_HOST=0.0.0.0
DATABASE_PATH=./data/digikot.db
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_TTL_HOURS=8
MQTT_PORT=1883

# Node.js 20–26 required (see package.json engines)

# Login rate limiting (4-digit PIN brute-force protection)
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# --- Dev: run API + UI ---
#   npm run dev:all
#   Open http://localhost:5173 (Vite proxies all /api to :3000)

# --- Production ---
#   npm run build && npm run start
#   Open http://<laptop-lan-ip>:3000

# DEV ONLY — never on restaurant laptop
# DEV_DIAGNOSTICS=1
# VITE_DEV_DIAGNOSTICS=1
# DEV_LOG_RETENTION_DAYS=14

# Realtime: socketio (default) or polling fallback
VITE_REALTIME_MODE=socketio
SETUP_UI_PASSWORD=change-me-installer
# Optional ESP device key (firmware SETUP_DEVICE_KEY)
# SETUP_DEVICE_KEY=

# WhatsApp Cloud API (server-side only; POST /api/whatsapp/send-bill — waiter + manager)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BILL_TEMPLATE_NAME=bill
WHATSAPP_RESTAURANT_NAME=OPULENCE Restaurant
WHATSAPP_TEMPLATE_LANGUAGE=en_US
