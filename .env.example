# =============================================================================
# KOT System — environment variables
# Copy this file to .env and adjust as needed.
# =============================================================================

# --- LOCAL DEV (single machine, localhost only) ------------------------------
# Start the Supabase stack: npm run supabase:start
# Run the frontend:         npm run dev

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=<paste the "Publishable" key from: npm run supabase:status>

# --- LAN (multiple devices on the same Wi-Fi / wired network) ---------------
# 1. Find your PC's LAN IP:  Run `ipconfig` → look for IPv4 Address (e.g. 192.168.1.10)
# 2. Change the URL below to use that IP instead of 127.0.0.1
# 3. Run the frontend with:  npm run dev:lan
# 4. Open Windows Firewall for inbound TCP on ports 54321 and 5173
#
# VITE_SUPABASE_URL=http://192.168.1.10:54321
# VITE_SUPABASE_ANON_KEY=<same publishable key as above>

# Realtime mode: 'supabase' = postgres_changes WebSocket (recommended).
# Set to 'polling' only if WebSocket fails on the LAN.
VITE_REALTIME_MODE=supabase

# Restaurant name in WhatsApp Click to Chat bill messages
# VITE_RESTAURANT_NAME=OPULENCE Restaurant

# --- WhatsApp Cloud API (Meta) — server-side only, no VITE_ prefix -----------
# Used by src/services/whatsappService.js (backend / Edge Function / Node script).
# Never import the WhatsApp service from browser code; tokens must not ship to clients.

WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BILL_TEMPLATE_NAME=bill
# Shown in WhatsApp template {{2}} and on the PDF
WHATSAPP_RESTAURANT_NAME=OPULENCE Restaurant
# Graph API version for Media Upload + messages (default v19.0)
# WHATSAPP_API_VERSION=v19.0
# Must exactly match the locale shown in Meta for template "bill" (e.g. en_US, en_GB, en)
WHATSAPP_TEMPLATE_LANGUAGE=en_US
