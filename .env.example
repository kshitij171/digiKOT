# =============================================================================
# digiKOT — SQLite + embedded stack (no Supabase / Docker required)
# =============================================================================

# --- Server (default port 3000 — avoids Windows port 80 admin requirement) ---
PORT=3000
LISTEN_HOST=0.0.0.0
DATABASE_PATH=./data/digikot.db
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_TTL_HOURS=8
MQTT_PORT=1883

# Login rate limiting (4-digit PIN brute-force protection)
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# --- Dev: run API + UI ---
#   npm run dev:all
#   Open http://localhost:5173 (Vite proxies /api and /socket.io to :3000)

# --- Production-style ---
#   npm run build && npm run start
#   Open http://localhost:3000

# Realtime: socketio (default) or polling fallback
VITE_REALTIME_MODE=socketio

# Pager install setup (Vite plugin /api/setup during dev)
SETUP_UI_PASSWORD=change-me-installer

# WhatsApp Cloud API (server-side only)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BILL_TEMPLATE_NAME=bill
WHATSAPP_RESTAURANT_NAME=OPULENCE Restaurant
WHATSAPP_TEMPLATE_LANGUAGE=en_US
