# =============================================================================
# KOT System — environment variables
# Copy this file to .env and adjust as needed.
# =============================================================================

# --- LOCAL DEV (Mac only, localhost) -----------------------------------------
# npm run supabase:start
# npm run dev

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=<paste the "Publishable" key from: npm run supabase:status>

# --- LAN / restaurant demo (phones on same Wi-Fi) ------------------------------
# No need to edit VITE_SUPABASE_URL for each Wi-Fi — the app uses the same host
# as the page (e.g. http://192.168.1.10:5173 → API :54321 on that IP).
#
#   npm run supabase:start
#   npm run demo          # prints all shareable links + starts Vite on 0.0.0.0
#   npm run demo:start    # supabase:start then demo
#   npm run install:full  # Mosquitto + Supabase + pager-bridge + Vite (pager install)
#
# Open the URLs printed in the terminal (not localhost on phones).
# Firewall: allow inbound TCP 5173 and 54321 on the laptop.
#
# Optional overrides:
# VITE_SUPABASE_URL=http://127.0.0.1:54321
# VITE_SUPABASE_URL_FORCE=true   # always use VITE_SUPABASE_URL, even on LAN IP pages

# Realtime mode: 'supabase' = postgres_changes WebSocket (recommended).
# Set to 'polling' only if WebSocket fails on the LAN.
VITE_REALTIME_MODE=supabase

# Restaurant name in WhatsApp Click to Chat bill messages
# VITE_RESTAURANT_NAME=OPULENCE Restaurant

# --- WhatsApp Cloud API (Meta) — server-side only, no VITE_ prefix -----------
# Used by src/services/whatsappService.js (backend / Edge Function / Node script).
# Never import the WhatsApp service from browser code; tokens must not ship to clients.

WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BILL_TEMPLATE_NAME=bill
# Shown in WhatsApp template {{2}} and on the PDF
WHATSAPP_RESTAURANT_NAME=OPULENCE Restaurant
# Graph API version for Media Upload + messages (default v19.0)
# WHATSAPP_API_VERSION=v19.0
# Must exactly match the locale shown in Meta for template "bill" (e.g. en_US, en_GB, en)
WHATSAPP_TEMPLATE_LANGUAGE=en_US

# --- Pager install setup (Vite plugin, server-side only) ----------------------
# Used by /api/setup/* during field install (npm run install:server / demo).
# Never expose service role or setup password to the browser bundle.

SETUP_UI_PASSWORD=change-me-installer
# Optional shared secret ESP firmware sends in hello body as device_key
# SETUP_DEVICE_KEY=
SUPABASE_SERVICE_ROLE_KEY=<from: npm run supabase:status>
SUPABASE_URL=http://127.0.0.1:54321

# pager-bridge + setup test-beep (MQTT publish path)
MQTT_URL=mqtt://127.0.0.1:1883

# UDP setup discovery (ESP probes udp/50505; started with install:full / demo — no env var needed)
