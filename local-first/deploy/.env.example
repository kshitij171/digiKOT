# Copy to deploy/.env and set strong secrets before: docker compose -f docker-compose.prod.yml --env-file deploy/.env up -d
#
# license.key must exist on the host at ./license/license.key (mounted read-only).
# Do NOT put license.key inside any Docker image build context as a COPY target.

# --- App ---
APP_ENV=production
APP_VERSION=1.0.0
LAN_BASE_URL=http://192.168.1.10

# --- Postgres (compose interpolation + server connection) ---
POSTGRES_DB=digikot
POSTGRES_USER=digikot
POSTGRES_PASSWORD=change_me_strong_postgres_password
DATABASE_URL=postgresql://digikot:change_me_strong_postgres_password@postgres:5432/digikot

# --- API server ---
PORT=3000
LISTEN_HOST=0.0.0.0
DEFAULT_RESTAURANT_ID=default

# Migrations: set to 0 after first deploy if you run migrations out-of-band
RUN_MIGRATIONS_ON_START=1

# --- MQTT (use Docker service hostname) ---
MQTT_URL=mqtt://mosquitto:1883
MQTT_USER=kot_server
MQTT_PASSWORD=change_me_mqtt_password

# --- License (Chunk 2 will enforce; paths are inside server container) ---
LICENSE_FILE_PATH=/app/license/license.key
PUBLIC_LICENSE_KEY_PATH=/app/license/public_key.pem

# --- Reserved for later auth/session work ---
SESSION_SECRET=change_me_long_random_secret
COOKIE_NAME=digikot_session
