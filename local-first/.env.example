# Copy to local-first/.env (gitignored) and adjust.

# Postgres (matches docker-compose defaults)
DATABASE_URL=postgresql://kot:kot_local_dev@localhost:5432/kot_local

# API (use LISTEN_HOST=127.0.0.1 if 0.0.0.0 fails in a restricted environment)
PORT=3000
LISTEN_HOST=0.0.0.0
NODE_ENV=development

# MQTT (must match mosquitto Dockerfile build args if you rebuild broker)
MQTT_URL=mqtt://127.0.0.1:1883
MQTT_USER=kot_server
MQTT_PASSWORD=kot_dev_pass

# Single default restaurant id (matches migrations seed)
DEFAULT_RESTAURANT_ID=default
