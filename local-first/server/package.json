{
  "name": "kot-local-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/app.js",
    "start": "node src/app.js",
    "db:migrate": "DOTENV_CONFIG_PATH=../.env node --import dotenv/config node_modules/node-pg-migrate/bin/node-pg-migrate.js up -m ../db/migrations",
    "db:down": "DOTENV_CONFIG_PATH=../.env node --import dotenv/config node_modules/node-pg-migrate/bin/node-pg-migrate.js down -m ../db/migrations",
    "db:seed": "DOTENV_CONFIG_PATH=../.env node --import dotenv/config ./scripts/seed.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "dotenv": "^16.4.5",
    "fastify": "^5.1.0",
    "mqtt": "^5.10.1",
    "pg": "^8.13.1",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "node-pg-migrate": "^7.9.1"
  }
}
